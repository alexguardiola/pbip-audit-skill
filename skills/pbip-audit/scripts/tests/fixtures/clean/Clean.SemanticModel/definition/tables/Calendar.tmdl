/// Shared calendar, one row per day.
table Calendar
	dataCategory: Time

	/// Calendar day.
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: [Date]

	/// Calendar year.
	column Year = YEAR('Calendar'[Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	/// Month number.
	column Month = MONTH('Calendar'[Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	partition Calendar = calculated
		mode: import
		source = CALENDAR(DATE(2020, 1, 1), DATE(2025, 12, 31))
