{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "pie",
  "position": {
    "x": 20,
    "y": 130,
    "z": 2000,
    "width": 400,
    "height": 300,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "pieChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Product"
                    }
                  },
                  "Property": "Category"
                }
              },
              "queryRef": "Product.Category",
              "nativeQueryRef": "Category"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Orders"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "Orders.Revenue",
              "nativeQueryRef": "Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue share by category'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
