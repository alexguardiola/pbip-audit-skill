table Calendar

	column Date
		dataType: dateTime
		isKey
		summarizeBy: none
		sourceColumn: [Date]

	column Year = YEAR('Calendar'[Date])
		dataType: int64
		summarizeBy: none

	column DateKey = YEAR('Calendar'[Date]) * 10000 + MONTH('Calendar'[Date]) * 100 + DAY('Calendar'[Date])
		dataType: int64
		isHidden
		summarizeBy: none

	partition Calendar = calculated
		mode: import
		source = CALENDAR(DATE(2020, 1, 1), DATE(2031, 12, 31))
