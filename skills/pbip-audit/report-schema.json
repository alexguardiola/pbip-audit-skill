{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pbip-audit findings",
  "description": "Findings produced by scan.py (check_type D) and extended by the agent with judgement (J) findings. Runtime (R) rules are listed under not_assessable.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "target",
    "summary",
    "findings",
    "not_assessable"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "pbip",
        "report_format",
        "model_format",
        "thin_report"
      ],
      "properties": {
        "pbip": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_format": {
          "type": "string",
          "enum": [
            "PBIR",
            "PBIR-Legacy",
            "unknown",
            "none"
          ]
        },
        "model_format": {
          "type": "string",
          "enum": [
            "TMDL",
            "TMSL",
            "none"
          ]
        },
        "thin_report": {
          "type": "boolean"
        }
      }
    },
    "options": {
      "type": "object"
    },
    "stats": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "by_severity"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "required": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "Info"
          ],
          "properties": {
            "Critical": {
              "type": "integer",
              "minimum": 0
            },
            "High": {
              "type": "integer",
              "minimum": 0
            },
            "Medium": {
              "type": "integer",
              "minimum": 0
            },
            "Low": {
              "type": "integer",
              "minimum": 0
            },
            "Info": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_pillar": {
          "type": "object"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "not_assessable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "title",
          "reason"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "pillar": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "description": "Per-pillar scores; formula in VALIDATION-AND-REPORTING.md. A pillar that could not be assessed (its files are missing or not PBIR/TMDL) has score null and assessed false, and is left out of the overall mean (schema 1.2).",
      "properties": {
        "formula": {
          "type": "string"
        },
        "weights": {
          "type": "object"
        },
        "overall": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pillars": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "score"
            ],
            "properties": {
              "score": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "assessed": {
                "type": "boolean"
              },
              "penalty": {
                "type": "integer",
                "minimum": 0
              },
              "by_severity": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "theme": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "rule_id",
        "title",
        "pillar",
        "severity",
        "check_type",
        "confidence",
        "classification",
        "message",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]{2}#[0-9]+$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pillar": {
          "type": "string",
          "enum": [
            "model",
            "dax",
            "performance",
            "governance",
            "visual-design",
            "storytelling",
            "interaction",
            "accessibility",
            "mobile",
            "domain"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "Info"
          ]
        },
        "check_type": {
          "type": "string",
          "enum": [
            "D",
            "J"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "defect",
            "recommendation"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "json_path": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "fix": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "false_positive",
            "needs_validation"
          ]
        },
        "reviewer_note": {
          "type": "string"
        },
        "original_severity": {
          "type": "string",
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "Info"
          ],
          "description": "Severity before a config severity_overrides entry was applied."
        },
        "origin": {
          "type": "object",
          "required": [
            "tool"
          ],
          "description": "Set on findings imported from another analyzer (EXT-* rules).",
          "properties": {
            "tool": {
              "type": "string"
            },
            "rule_id": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            },
            "file": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
