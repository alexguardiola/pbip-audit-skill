            {
              "id": "MOD-04",
              "name": "TimeIntelligenceDaxWithoutAMarkedDateTable",
              "shortDescription": {
                "text": "Time-intelligence DAX without a marked date table"
              },
              "fullDescription": {
                "text": "Functions such as SAMEPERIODLASTYEAR or DATESYTD require a contiguous date column. Without a marked date table they can return wrong results when the relationship is not on a date-typed column."
              },
              "help": {
                "text": "How to verify: Any measure using a time-intelligence function while no table has `dataCategory: Time`.\nFix: Mark the calendar table as a date table (Table tools > Mark as date table).",
                "markdown": "**How to verify:** Any measure using a time-intelligence function while no table has `dataCategory: Time`.\n\n**Fix:** Mark the calendar table as a date table (Table tools > Mark as date table)."
              },
              "helpUri": "https://learn.microsoft.com/power-bi/guidance/model-date-tables",
              "defaultConfiguration": {
                "level": "error"
