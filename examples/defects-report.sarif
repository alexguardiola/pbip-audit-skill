            {
              "id": "MOD-08",
              "name": "FloatingPointDataType",
              "shortDescription": {
                "text": "Floating-point (double) data type"
              },
              "fullDescription": {
                "text": "Double can introduce rounding differences in sums; fixed decimal (`decimal`) or whole numbers are exact and compress better."
              },
              "help": {
                "text": "How to verify: `dataType: double` on columns.\nFix: Use Fixed decimal number for currency, whole number for counts.",
                "markdown": "**How to verify:** `dataType: double` on columns.\n\n**Fix:** Use Fixed decimal number for currency, whole number for counts."
