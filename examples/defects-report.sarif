            {
              "id": "MOD-10",
              "name": "UnusedColumnsOrMeasures",
              "shortDescription": {
                "text": "Unused columns or measures"
              },
              "fullDescription": {
                "text": "Objects referenced by no visual, filter, measure, relationship, sort or RLS rule cost memory and maintenance."
              },
              "help": {
                "text": "How to verify: Join the report reference index with every DAX text, relationship, sortByColumn and hierarchy level. Objects listed in an `--external-usage` file (used by other reports, Excel or paginated reports on the same model) count as used.\nFix: Remove them after checking that no other report bound to this model uses them; record known external consumers in an external-usage file.",
                "markdown": "**How to verify:** Join the report reference index with every DAX text, relationship, sortByColumn and hierarchy level. Objects listed in an `--external-usage` file (used by other reports, Excel or paginated reports on the same model) count as used.\n\n**Fix:** Remove them after checking that no other report bound to this model uses them; record known external consumers in an external-usage file."
              },
              "helpUri": "https://learn.microsoft.com/power-bi/guidance/import-modeling-data-reduction",
              "defaultConfiguration": {
