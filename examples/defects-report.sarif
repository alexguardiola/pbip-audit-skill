            {
              "id": "MOD-01",
              "name": "BidirectionalRelationship",
              "shortDescription": {
                "text": "Bidirectional relationship"
              },
              "fullDescription": {
                "text": "Both-direction cross filtering creates ambiguous filter paths, slows queries and can give unexpected totals. It is justified mainly for bridge tables and some one-to-one cases."
              },
              "help": {
                "text": "How to verify: `crossFilteringBehavior: bothDirections` in relationships.tmdl.\nFix: Set the relationship to single direction; use `CROSSFILTER` inside the specific measures that need it.",
                "markdown": "**How to verify:** `crossFilteringBehavior: bothDirections` in relationships.tmdl.\n\n**Fix:** Set the relationship to single direction; use `CROSSFILTER` inside the specific measures that need it."
              },
              "helpUri": "https://learn.microsoft.com/power-bi/guidance/relationships-bidirectional-filtering",
              "defaultConfiguration": {
