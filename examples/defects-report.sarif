            {
              "id": "MOD-03",
              "name": "InactiveRelationshipNeverActivatedWithUserelationship",
              "shortDescription": {
                "text": "Inactive relationship never activated with USERELATIONSHIP"
              },
              "fullDescription": {
                "text": "An inactive relationship that no measure activates is dead weight and often a forgotten modelling mistake."
              },
              "help": {
                "text": "How to verify: `isActive: false` with no `USERELATIONSHIP(...)` call in any DAX expression that names both columns.\nFix: Delete the relationship, or add the measures that use it.",
                "markdown": "**How to verify:** `isActive: false` with no `USERELATIONSHIP(...)` call in any DAX expression that names both columns.\n\n**Fix:** Delete the relationship, or add the measures that use it."
